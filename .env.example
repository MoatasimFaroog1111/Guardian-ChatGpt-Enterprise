GUARDIAN_DB=/data/guardian.db
GUARDIAN_API_URL=http://guardian:8000

# Preferred production configuration: one JSON secret.
# GUARDIAN_CONFIG={"DATABASE_URL":"postgresql://...","GUARDIAN_EDGE_SECRET":"...","UPSTASH_REDIS_REST_URL":"...","UPSTASH_REDIS_REST_TOKEN":"...","R2_ENDPOINT_URL":"...","R2_ACCESS_KEY_ID":"...","R2_SECRET_ACCESS_KEY":"...","R2_BUCKET":"guardian-enterprise"}

# Individual environment variables remain supported for local development.
# GUARDIAN_EDGE_SECRET=
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis REST
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 (S3-compatible)
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=guardian-enterprise

# Telegram / ERP
# TELEGRAM_BOT_TOKEN=
# ODOO_URL=
# ODOO_DB=
# ODOO_API_KEY=

# GPU routing: configure either or both. No idle GPU is required.
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
# MODAL_GPU_URL=
# MODAL_TOKEN=

# Generic model provider fallback
# MODEL_PROVIDER_URL=
# MODEL_PROVIDER_API_KEY=
